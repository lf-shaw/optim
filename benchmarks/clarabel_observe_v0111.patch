diff --git a/examples/rust/observe.rs b/examples/rust/observe.rs
new file mode 100644
index 0000000..bfaba85
--- /dev/null
+++ b/examples/rust/observe.rs
@@ -0,0 +1,13 @@
+use clarabel::solver::*;
+use std::fs::File;
+
+fn main() {
+    for path in std::env::args().skip(1) {
+        eprintln!("OBS CASE {}", path);
+        let mut file = File::open(&path).unwrap();
+        let mut solver = DefaultSolver::<f64>::load_from_file(&mut file, None).unwrap();
+        solver.solve();
+        let s = &solver.solution;
+        println!("{}",serde_json::json!({"case":path,"status":format!("{:?}",s.status),"iterations":s.iterations,"objective":s.obj_val,"x":s.x,"primal_residual":s.r_prim,"dual_residual":s.r_dual}));
+    }
+}
